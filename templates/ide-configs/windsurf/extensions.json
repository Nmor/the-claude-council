// Windsurf recommended extensions.
// Apply by copying into <workspace>/.windsurf/extensions.json OR by
// running `windsurf --install-extension <id>` per recommendation
// (see this directory's README.md for the install script).
//
// Windsurf is a VS Code fork (Codeium) and supports both the
// Microsoft Marketplace and Open-VSX. Every publisher in this list
// is on the allowlist in ~/.claude/rules/common/install-allowlist.md.
// Adding a new extension whose publisher is NOT on that allowlist
// requires explicit user approval per the rule.
//
// Notes:
// - Windsurf ships Cascade (built-in AI chat) and Supercomplete
//   (in-editor AI). When using Anthropic's Claude Code alongside,
//   disable Cascade per-workspace to avoid prompting competition
//   (see settings.json `codeium.enableCodeLens` + readme §4).
// - `anthropic.claude-code` is published to both Marketplace + Open-VSX
//   and works in Windsurf.
{
  "recommendations": [
    // ============================================================
    // Anthropic / Claude
    // ============================================================
    "anthropic.claude-code",

    // ============================================================
    // Formatting / linting (same allowlist as VS Code)
    // ============================================================
    "esbenp.prettier-vscode",
    "dbaeumer.vscode-eslint",
    "editorconfig.editorconfig",
    "sonarsource.sonarlint-vscode",
    "davidanson.vscode-markdownlint",
    "tamasfe.even-better-toml",

    // ============================================================
    // Git
    // ============================================================
    "eamodio.gitlens",
    "mhutchie.git-graph",

    // ============================================================
    // Python
    // ============================================================
    "ms-python.python",
    "ms-python.vscode-pylance",
    "ms-python.debugpy",
    "charliermarsh.ruff",
    "ms-toolsai.jupyter",

    // ============================================================
