    "hashicorp.terraform",
    "ms-azuretools.vscode-docker",
    "ms-kubernetes-tools.vscode-kubernetes-tools",
    "redhat.vscode-yaml",

    // ============================================================
    // Testing
    // ============================================================
    "vitest.explorer",
    "ms-playwright.playwright",
    "ryanluker.vscode-coverage-gutters",

    // ============================================================
    // Markdown / docs
    // ============================================================
    "bierner.markdown-mermaid",
    "yzhang.markdown-all-in-one",

    // ============================================================
    // C / C++ / C#
    // ============================================================
    "ms-vscode.cpptools",
    "ms-dotnettools.csharp",

    // ============================================================
    // Dart / Flutter
    // ============================================================
    "Dart-Code.dart-code",
    "Dart-Code.flutter",

    // ============================================================
    // Swift
