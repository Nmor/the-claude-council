  "unwantedRecommendations": [
    // Known-bad / typosquatted / abandoned — per install-allowlist.md
    "MaterialTheme-Free.material-theme",
    "tintinweb.solidity-visual-auditor",
    "SimonSiefke.prettier-vscode",
    "Microsoft.CodeRunner",
    "chinwobble.ethcode",
    // GitHub Copilot in Windsurf is redundant with Cascade/Supercomplete
    // AND with Claude Code; pick ONE AI assistant per workspace to
    // avoid three AI suggestion popups overlapping. If you actually
    // want Copilot here, remove this entry consciously.
    "github.copilot",
    "github.copilot-chat"
  ]
